DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arabic_course_platform"
NEXTAUTH_SECRET="replace-with-a-strong-secret"
AUTH_SECRET="replace-with-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-admin-password"

# VCDN video delivery
VCDN_API_KEY="your-vcdn-api-key"
VCDN_BASE_URL="https://cdn.vcdn.me"

# Google Sheets integration (server-side only)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="your-google-service-account-private-key"
GOOGLE_SHEETS_SPREADSHEET_ID="your-spreadsheet-id"

# Cloudinary remains available for non-video media
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
