DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arabic_course_platform"
NEXTAUTH_SECRET="replace-with-a-strong-secret"
AUTH_SECRET="replace-with-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/arabic_course_platform?schema=public"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Mobile API authentication
MOBILE_AUTH_SECRET=""

# Distributed rate limiting (required by password-reset and video-playback endpoints)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# VCDN video delivery
VCDN_API_KEY="your-vcdn-api-key"
VCDN_BASE_URL="https://cdn.vcdn.me"

# Google Sheets integration (server-side only)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="your-google-service-account-private-key"
GOOGLE_SHEETS_SPREADSHEET_ID="your-spreadsheet-id"

# Cloudinary remains available for non-video media
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Transactional email (Resend)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Nawah <no-reply@example.com>"

# Public application URL used in password-reset links
APP_BASE_URL="http://localhost:3000"
