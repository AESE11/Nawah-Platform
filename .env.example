DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arabic_course_platform"
NEXTAUTH_SECRET="replace-with-a-strong-secret"
AUTH_SECRET="replace-with-a-strong-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@arabic-course-platform.local"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"

# Mux server-side configuration (never expose these to the browser or NEXT_PUBLIC_ variables)
MUX_SIGNING_KEY="your-mux-signing-key-id"
MUX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_MUX_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# Optional bounded playback-token lifetime (minimum 5m, maximum 24h; defaults to 1h)
MUX_PLAYBACK_TOKEN_TTL="15m"

# Cloudinary remains available for non-video media
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
